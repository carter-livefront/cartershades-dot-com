---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
  href?: string;
  /**
   * Above-the-fold cards should opt in. Eager-loads the image, marks it as
   * high-priority, and skips lazy-loading so the card paints with the rest of
   * the page instead of after the swap settles.
   */
  priority?: boolean;
}

const { title, subtitle, image, imageAlt, href, priority = false } = Astro.props;
const Tag = href ? "a" : "article";
---

<Tag class="card" href={href}>
  <Image
    class="card-image"
    src={image}
    alt={imageAlt}
    widths={[600, 1200]}
    sizes="(max-width: 640px) 100vw, 50vw"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
  />
  <div class="card-label surface-glass">
    <h4>{title}</h4>
    <p>{subtitle}</p>
  </div>
</Tag>

<style>
  .card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  /* Subtle directional hairline — 12% white on the top-left edge fading to
   * 12% black on the bottom-right, like light from above-left.
   *
   * Implemented with the gradient-border trick: a 1px transparent border
   * filled by a 135° gradient, masked so only the border (not the fill)
   * shows through. Drawn on top of the absolutely-positioned image since an
   * inset box-shadow on .card itself would render behind it. */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    border-radius: inherit;
    background: linear-gradient(
        135deg,
        oklch(1 0 0 / 0.12),
        oklch(0 0 0 / 0.12)
      )
      border-box;
    -webkit-mask:
      linear-gradient(#fff 0 0) padding-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) padding-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  .card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Subtle hover: image leans toward the viewer. */
  @media (prefers-reduced-motion: no-preference) {
    .card-image {
      transition: transform 400ms ease;
    }
    .card:hover .card-image {
      transform: scale(1.04);
    }
  }

  .card-label {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    max-width: calc(100% - var(--space-sm) * 2);
    padding: var(--space-sm);
    /* surface-glass supplies blur, tint, border, shadow, and radius. */
  }

  /* On hover-capable devices ABOVE the mobile breakpoint, hide the label
   * until the card is hovered or keyboard-focused. Touch devices and small
   * viewports (≤640px) keep the label visible always.
   *
   * Backdrop-filter is expensive to composite even when the layer is fully
   * transparent, so we strip it (along with the tint and shadow inherited
   * from .surface-glass) until hover/focus actually reveals the label. */
  @media (hover: hover) and (min-width: 641px) {
    .card-label {
      opacity: 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      box-shadow: none;
      border-color: transparent;
      transition:
        opacity 300ms ease,
        background 300ms ease,
        backdrop-filter 300ms ease,
        -webkit-backdrop-filter 300ms ease,
        box-shadow 300ms ease,
        border-color 300ms ease;
    }
    .card:hover .card-label,
    .card:focus-visible .card-label {
      opacity: 1;
      background: oklch(from var(--canvas) l c h / 0.6);
      backdrop-filter: blur(20px) saturate(140%);
      -webkit-backdrop-filter: blur(20px) saturate(140%);
      box-shadow:
        inset 0 1px 0 oklch(1 0 0 / 0.12),
        0 12px 32px oklch(0 0 0 / 0.12);
      border-color: oklch(from var(--ink) l c h / 0.08);
    }
  }

  @media (hover: hover) and (min-width: 641px) and (prefers-reduced-motion: reduce) {
    .card-label {
      transition: none;
    }
  }

  /* Title and subtitle sit flush — line-height provides natural spacing. */
  .card-label > * {
    margin: 0;
  }
</style>
